{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits"
  ],
  "timezone": "Europe/Berlin",
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "Dependency Dashboard",
  "prHourlyLimit": 2,
  "prConcurrentLimit": 8,
  "rebaseWhen": "behind-base-branch",
  "ignoreTests": false,
  "platformAutomerge": false,
  "rangeStrategy": "bump",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "labels": [
    "dependencies"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am on monday"
    ],
    "automerge": true,
    "automergeType": "pr"
  },
  "packageRules": [
    {
      "description": "Automerge digest, pin, patch, and minor updates once CI passes.",
      "matchUpdateTypes": [
        "digest",
        "pin",
        "pinDigest",
        "patch",
        "minor"
      ],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Keep major updates explicit.",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "dependencyDashboardApproval": true
    },
    {
      "description": "Group GitHub Actions updates together.",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions",
      "groupSlug": "github-actions",
      "automerge": true,
      "automergeType": "pr",
      "dependencyDashboardApproval": false
    },
    {
      "description": "Do not add npm as a separate tool; Bun manages packages and Node already includes npm.",
      "matchFileNames": [
        ".mise.toml"
      ],
      "matchDepNames": [
        "npm"
      ],
      "enabled": false
    },
    {
      "description": "Group docs site dependencies together.",
      "matchFileNames": [
        "package.json",
        "bun.lock"
      ],
      "groupName": "site dependencies",
      "groupSlug": "site-dependencies"
    },
    {
      "description": "Update the VuePress release set together.",
      "matchPackageNames": [
        "vuepress",
        "vuepress-theme-plume",
        "@mdit/**",
        "@pengzhanbo/utils",
        "@vuepress/**",
        "@vuepress-plume/**"
      ],
      "groupName": "VuePress stack",
      "groupSlug": "vuepress-stack"
    }
  ]
}
