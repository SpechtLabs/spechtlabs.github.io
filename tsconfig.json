{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["docs/.vuepress/**/*.ts"],
  "exclude": ["docs/.vuepress/.temp", "docs/.vuepress/.cache", "docs/.vuepress/dist"]
}
